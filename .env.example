# ============================================================
# AI 数仓 Agent —— 环境变量配置示例
# 复制为 .env 后按需修改：  cp .env.example .env
# ============================================================

# ---------- LLM 提供方 ----------
# provider 可选: mock | openai_compatible
#   mock              -> 无需任何 API Key，离线跑通全链路（推荐先用它跑 demo）
#   openai_compatible -> 接入 DeepSeek / 阿里云百炼(Qwen) / 本地 vLLM 等 OpenAI 兼容服务
LLM_PROVIDER=mock

# 当 LLM_PROVIDER=openai_compatible 时填写以下三项
# DeepSeek 示例：
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
# 阿里云百炼 Qwen 示例：
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen2.5-coder-32b-instruct
# 本地 vLLM 部署 Qwen2.5-Coder-32B 示例：
#   LLM_BASE_URL=http://localhost:8000/v1
#   LLM_MODEL=Qwen2.5-Coder-32B-Instruct
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# ---------- 数仓连接 ----------
# 默认使用本地 SQLite 示例数仓（scripts/init_db.py 生成），开箱即用
# 生产环境替换为 PostgreSQL / Presto / StarRocks 等
WAREHOUSE_URL=sqlite:///data/warehouse.db

# ---------- 向量库 ----------
# 可选: builtin | milvus
#   builtin -> 内置轻量向量库（基于 SQLite，零依赖，用于 demo / 小规模）
#   milvus  -> 接入 Milvus（需 docker-compose 启动，并 pip install pymilvus）
VECTOR_STORE=builtin
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ---------- Agent 行为 ----------
SQL_MAX_RETRY=2          # SQL 生成失败的最大重试次数（对应图中 retry_count < 2）
SQL_RESULT_LIMIT=200     # 沙箱执行强制 LIMIT，防止大结果集
